# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (keep examples)
.env
.env.*
!.env.example

# Laravel (backend)
/backend/laravel-api/vendor/
/backend/laravel-api/node_modules/
/backend/laravel-api/storage/*.key
/backend/laravel-api/storage/logs/
/backend/laravel-api/storage/framework/cache/
/backend/laravel-api/storage/framework/sessions/
/backend/laravel-api/storage/framework/testing/
/backend/laravel-api/storage/framework/views/
/backend/laravel-api/bootstrap/cache/*.php
/backend/laravel-api/.phpunit.result.cache

# Next.js (frontend)
/frontend/nextjs-app/node_modules/
/frontend/nextjs-app/.next/
/frontend/nextjs-app/out/
/frontend/nextjs-app/.turbo/
/frontend/nextjs-app/.eslintcache

# React Native / Expo (mobile)
/mobile/react-native-app/node_modules/
/mobile/react-native-app/.expo/
/mobile/react-native-app/.expo-shared/
/mobile/react-native-app/dist/
/mobile/react-native-app/web-build/
/mobile/react-native-app/android/
/mobile/react-native-app/ios/
/mobile/react-native-app/*.keystore
/mobile/react-native-app/*.p8
/mobile/react-native-app/*.p12
/mobile/react-native-app/*.mobileprovision

# Coverage / test artifacts
coverage/
*.lcov

# Package manager caches (optional safety)
.pnpm-store/
.npm/
.yarn/
